// =============================================================================
// models/yolov8s/config.pbtxt  (Triton model config)
// =============================================================================

name: "yolov8s"
platform: "onnxruntime_onnx"
max_batch_size: 8

input [{
  name: "images"
  data_type: TYPE_FP32
  dims: [3, 640, 640]
 }]

output [{
   name: "output0"
   data_type: TYPE_FP32
   dims: [84, 8400]
}]

dynamic_batching {
  preferred_batch_size: [4, 8]
  max_queue_delay_microseconds: 10000
}

instance_group [{
  count: 1
  kind: KIND_GPU
}]